							</field>
						</shadow>
					</value>
					<value name="delay">
						<shadow type="math_number">
							<field name="NUM">
								10
							</field>
						</shadow>
					</value>
				</block>
				<block type="qtpi_servo_rotate"></block>
				<block type="qtpi_servo_sweep">
				</block>
				<block type="qtpi_servo_current_position">
