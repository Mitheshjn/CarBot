<xml xmlns="https://developers.google.com/blockly/xml" id="toolbox">
  <!-- Logic -->
  <category name="Logic" colour="#ffb400">
    <block type="controls_if"></block>
    <block type="logic_compare"></block>
    <block type="logic_operation"></block>
    <block type="logic_negate"></block>
    <block type="logic_boolean"></block>
  </category>
  <!-- Loops -->
  <category name="Loops" colour="#123456">
    <block type="controls_repeat_ext">
      <value name="TIMES">
        <shadow type="math_number"><field name="NUM">10</field></shadow>
      </value>
    </block>
    <block type="controls_whileUntil"></block>
    <block type="controls_for">
      <value name="FROM"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
      <value name="TO"><shadow type="math_number"><field name="NUM">10</field></shadow></value>
      <value name="BY"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
    </block>
    <block type="controls_flow_statements"></block>
  </category>
  <!-- Math -->
  <category name="Math" colour="#008000">
    <block type="lists_create_with">
      <mutation items="0"></mutation>
    </block>
    <block type="lists_create_with">
      <mutation items="3"></mutation>
    </block>
		<block type="math_number"><field name="NUM">123</field></block>
		<block type="math_arithmetic"><value name="A"><shadow type="math_number"><field name="NUM">1</field></shadow></value><value name="B"><shadow type="math_number"><field name="NUM">1</field></shadow></value></block>
		<block type="math_single"><value name="NUM"><shadow type="math_number"><field name="NUM">9</field></shadow></value></block>
		<block type="math_trig"><value name="NUM"><shadow type="math_number"><field name="NUM">45</field></shadow></value></block>
		<block type="math_constant"></block>		
    <block type="math_number_property"><value name="NUMBER_TO_CHECK"><shadow type="math_number"><field name="NUM">0</field></shadow></value></block>
		<block type="math_round"><value name="NUM"><shadow type="math_number"><field name="NUM">3.1</field></shadow></value></block>
		<block type="math_random_int"><value name="FROM"><shadow type="math_number"><field name="NUM">1</field></shadow></value><value name="TO"><shadow type="math_number"><field name="NUM">100</field></shadow></value></block>
	</category>
  <!-- Text -->
  <category name="Text" colour="160">
    <block type="text"></block>
    <block type="text_print">
      <value name="TEXT">
        <shadow type="text"><field name="TEXT">Hello lib</field></shadow>
      </value>
    </block>
    <block type="text_join"></block>
    <block type="text_length"></block>
  </category>
  <!-- Variables -->
  <category name="Variables" colour="330" custom="VARIABLE"></category>
  <!-- Custom Hardware -->
    <category name="Motor" colour="110">
				<block type="lib_left_motor_initialize">
				</block>
				<block type="lib_right_motor_initialize">
				</block>
				<block type="lib_motor_rotate">
				</block>
			</category>
    <category name="ARGB" colour="224">
				<block type="lib_argb_initialize">
				</block>
				<block type="lib_argb_clear">
				</block>
				<block type="lib_argb_clear_all">
				</block>
				<block type="lib_argb_show">
				</block>
				<block type="lib_argb_red">
				</block>
				<block type="lib_argb_green">
				</block>
				<block type="lib_argb_blue">
				</block>
				<block type="lib_argb_set">
					<value name="red">
						<shadow type="math_number">
							<field name="NUM">
								255
							</field>
						</shadow>
					</value>
					<value name="green">
						<shadow type="math_number">
							<field name="NUM">
								255
							</field>
						</shadow>
					</value>
					<value name="blue">
						<shadow type="math_number">
							<field name="NUM">
								255
							</field>
						</shadow>
					</value>
				</block>
			</category>
    <category name="Servo" colour="230">
				<block type="lib_servo_initialize">
					<value name="step">
						<shadow type="math_number">
							<field name="NUM">
								10
							</field>
						</shadow>
					</value>
					<value name="delay">
						<shadow type="math_number">
							<field name="NUM">
								10
							</field>
						</shadow>
					</value>
				</block>
				<block type="lib_servo_rotate"></block>
			</category>
    <category name="MPU6050" colour="224">
				<block type="lib_mpu6050_initialize">
				</block>
				<block type="lib_mpu6050_enable_gyro">
				</block>
				<block type="lib_mpu6050_disable_gyro">
				</block>
				<block type="lib_mpu6050_get_gyro">
				</block>
				<block type="lib_mpu6050_enable_accel">
				</block>
				<block type="lib_mpu6050_disable_accel">
				</block>
				<block type="lib_mpu6050_get_accel">
				</block>
			</category>
    <category name="TOF" colour="180">
				<block type="lib_tof_initialize">
				</block>
				<block type="lib_tof_read_distance">
				</block>
			</category>
    <category name="LDR" colour="165">
				<block type="lib_ldr_initialize">
				</block>
				<block type="lib_ldr_read">
				</block>
			</category>
    <category name="OLED" colour="180">
				<block type="lib_display_oled_initialize">
				</block>
				<block type="lib_display_oled_clear">
				</block>
				<block type="lib_display_oled_show">
				</block>
				<block type="lib_display_oled_draw_pixel">
				</block>
				<block type="lib_display_oled_draw_text">
				</block>
			</category>
    <category name="Buzzer" colour="32">
				<block type="lib_buzzer_initialize">
				</block>
				<block type="lib_buzzer_on">
				</block>
				<block type="lib_buzzer_off">
				</block>
				<block type="lib_buzzer_buzz">
					<value name="secs">
						<shadow type="math_number">
							<field name="NUM">
								1
							</field>
						</shadow>
					</value>
				</block>
			</category>
    <category name="DHT22" colour="120">
		<block type="lib_dht22_initialize"></block>
		<block type="lib_temperature_read"></block>
		<block type="lib_humidity_read"></block>
	</category>
    <category name="Camera" colour="260">
		<block type="lib_camera_initialize"></block>
		<block type="lib_camera_take_picture"></block>
		<block type="lib_camera_convert_to_grayscale"></block>
		<block type="lib_camera_read_console_values"></block>
		<block type="lib_camera_button">
			<field name="NUM">1</field>
		</block>
		<block type="lib_camera_train_classifier">
			<field name="CLASSIFIER">image</field>
			<value name="BUTTON">
				<shadow type="lib_camera_button">
					<field name="NUM">1</field>
				</shadow>
			</value>
		</block>
		<block type="lib_camera_train_classifier">
			<field name="CLASSIFIER">gesture</field>
			<value name="BUTTON">
				<shadow type="lib_camera_button">
					<field name="NUM">1</field>
				</shadow>
			</value>
		</block>
		<block type="lib_camera_clear"></block>
	</category>
		<!-- System -->
	<category name="System" colour="60">
		<block type="lib_neo_sleep">
		<value name="duration">
			<shadow type="math_number"><field name="NUM">1</field></shadow>
		</value>
		</block>
		<block type="lib_neo_sleep_ms">
		<value name="duration">
			<shadow type="math_number"><field name="NUM">500</field></shadow>
		</value>
		</block>
	</category>
	</xml>
